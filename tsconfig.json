{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "relay-core": ["packages/relay-core/src/index.ts"],
      "relay-backend": ["packages/relay-backend/src/index.ts"],
      "relay-daemon": ["packages/relay-daemon/src/index.ts"],
      "relay-tui": ["packages/relay-tui/src/tui.tsx"]
    }
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"],
  "exclude": ["packages/relay-web/**"]
}
