{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "../dist",
    "rootDir": "..",
    "types": ["node"],
    "baseUrl": "..",
    "paths": {
      "relay-core": ["packages/relay-core/src/index.ts"],
      "relay-core/api-url": ["packages/relay-core/src/api-url.ts"],
      "relay-chat": ["packages/relay-chat/src/index.ts"],
      "relay-daemon": ["packages/relay-daemon/src/index.ts"],
      "relay-supervisor": ["packages/relay-supervisor/src/index.ts"],
      "relay-tui": ["packages/relay-tui/src/tui.tsx"]
    }
  },
  "include": ["../packages/**/*.ts", "../packages/**/*.tsx", "../web/tests/**/*.ts", "../web/tests/**/*.tsx"],
  "exclude": ["../web/.next/**", "../web/src/app/**", "../web/src/components/**"]
}
