ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# Codex CLI (also accepts CODEX_API_KEY as an alias for OPENAI_API_KEY).
# Orchestrix writes ~/.codex/config.toml with a custom "dashscope" provider using
# wire_api = "chat" + requires_openai_auth = false, so Codex talks to DashScope's
# /chat/completions endpoint. (DashScope's /responses endpoint rejects role="tool"
# messages, so the chat wire API is required for Codex's tool-using review.)
# Any DashScope chat model with tool-calling works here, e.g. qwen3-coder-plus
# (best for review), qwen3-max, deepseek-v4-pro.
# DashScope example:
#   OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   OPENAI_MODEL=qwen3-coder-plus
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
